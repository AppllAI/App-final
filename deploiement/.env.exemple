# Copie ce fichier en « .env » SUR LE SERVEUR (jamais sur GitHub) et remplis-le.

# Adresse de l'API : l'IP de ton serveur avec des tirets + .sslip.io (gratuit, HTTPS automatique)
DOMAINE_API=api.203-0-113-7.sslip.io
# Adresse du site GitHub Pages (seule origine autorisée à appeler l'API)
SITE_ORIGINE=https://brrrr999.github.io
# Adresse complète du site (pour les liens dans les emails)
SITE_URL=https://brrrr999.github.io/App-final

# Clé Claude (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
# Budget IA maximum par utilisateur et par jour, en euros
BUDGET_JOUR_EUR=1

# La boîte du service (une adresse Gmail DÉDIÉE + mot de passe d'application à 16 lettres)
EMAIL_ADRESSE=
EMAIL_MOT_DE_PASSE=
SMTP_HOTE=smtp.gmail.com
SMTP_PORT=465
IMAP_HOTE=imap.gmail.com

# Mode économe : un agent ne tourne que quand on lui parle ; le travail de fond passe par des tournées.
# MAX_AGENTS = agents allumés en même temps (≈100 Mo chacun) : 6 pour 4 Go de mémoire, 30 pour 16 Go.
MODE_ECONOME=1
MAX_AGENTS=6
TOURNEE_MIN=30
INACTIF_MIN=10

# Clé secrète du serveur : génère-la avec  openssl rand -hex 32
SECRET_SERVEUR=

# Connexion Google (console.cloud.google.com → Identifiants → ID client OAuth « Application Web »)
GOOGLE_CLIENT_ID=
# Connexion Apple (nécessite un compte Apple Developer à 99 $/an) — laisser vide pour masquer le bouton
APPLE_CLIENT_ID=
